{
  "name": "openferry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenFerry — a local-first gateway for AI coding tools",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "gateway": "tsx apps/gateway-cli/src/main.ts",
    "desktop": "pnpm --filter @openferry/desktop dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.5"
  }
}
